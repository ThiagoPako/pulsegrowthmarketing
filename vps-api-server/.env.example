# ─── PostgreSQL local ────────────────────────
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=pulse_db
PG_USER=pulse_user
PG_PASSWORD=SUA_SENHA_AQUI

# ─── JWT ─────────────────────────────────────
JWT_SECRET=GERE_UM_SECRET_FORTE_AQUI
JWT_EXPIRES_IN=30d
ALLOW_LEGACY_SUPABASE_AUTH=true

# ─── Supabase (transitional — will be removed) ──
SUPABASE_URL=https://zqpplhbzhetabjopdzcn.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# ─── AI ──────────────────────────────────────
GOOGLE_GEMINI_API_KEY=
API_PORT=3002

# ─── Optional ───────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ─── Portal do cliente (sessão própria) ──────
# 'enforce' (padrão): /api/portal-actions e /api/portal-recordings exigem o token do login do portal
# (ou o JWT da equipe). 'log': só registra "[Portal-Auth] ... sem sessão" no log e deixa passar.
# Primeiro deploy da sessão do portal: subir com PORTAL_AUTH_MODE=log. Abas do portal abertas com o
# bundle antigo não mandam o token e não conferem erro (mostrariam "aprovado" sem gravar nada).
# Quando o log parar de mostrar "[Portal-Auth] ... sem sessão" (alguns dias), trocar para enforce
# e reiniciar a API (pm2 restart pulse-api --update-env).
# PORTAL_AUTH_MODE=log
# PORTAL_JWT_SECRET=          (opcional; sem ele, deriva do JWT_SECRET)
# PORTAL_JWT_EXPIRES_IN=7d
