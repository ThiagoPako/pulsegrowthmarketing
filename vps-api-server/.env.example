# ─── PostgreSQL local ────────────────────────
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=pulse_db
PG_USER=pulse_user
PG_PASSWORD=SUA_SENHA_AQUI

# ─── JWT ─────────────────────────────────────
JWT_SECRET=GERE_UM_SECRET_FORTE_AQUI
JWT_EXPIRES_IN=30d
ALLOW_LEGACY_SUPABASE_AUTH=true

# ─── Supabase (transitional — will be removed) ──
SUPABASE_URL=https://zqpplhbzhetabjopdzcn.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# ─── AI ──────────────────────────────────────
GOOGLE_GEMINI_API_KEY=
API_PORT=3002

# ─── Optional ───────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ─── Portal do cliente (sessão própria) ──────
# 'enforce': /api/portal-actions e /api/portal-recordings exigem o token do login do portal
# (ou o JWT da equipe). 'log': só registra "[Portal-Auth] ... sem sessão" no log e deixa passar.
# Sem PORTAL_AUTH_MODE: 'log' até PORTAL_AUTH_ENFORCE_FROM (padrão 2026-10-28T03:00:00Z) e 'enforce'
# depois, sozinho. A transição cobre abas do portal abertas com o bundle antigo, que não mandam o
# token e não conferem erro (mostrariam "aprovado" sem gravar nada). Definir aqui fixa o modo.
# PORTAL_AUTH_MODE=enforce
# PORTAL_AUTH_ENFORCE_FROM=2026-10-28T03:00:00Z
# PORTAL_JWT_SECRET=          (opcional; sem ele, deriva do JWT_SECRET)
# PORTAL_JWT_EXPIRES_IN=7d
